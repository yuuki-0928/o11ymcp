# deploy/compose/.env としてコピーして値を埋めてください (`cp .env.example .env`)。
# .env はコミットしない (.gitignoreで除外済み)。

# --- ClickHouse ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-clickhouse
CLICKHOUSE_DB=default

# --- MinIO (ClickHouseのコールドストレージ, S3互換) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-min8chars

# --- Query API ---
QUERY_API_KEY=change-me-query-api-key

# --- MCP Server ---
MCP_API_KEY=change-me-mcp-api-key

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me-grafana
