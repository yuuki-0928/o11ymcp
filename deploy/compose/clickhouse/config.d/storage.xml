<!--
  ホット(ローカルディスク)/コールド(MinIO, S3互換)のTiered Storage定義 (FR-ST-03)。

  重要: 新しいポリシー "hot_cold" のホット側ボリューム名を、ClickHouse組み込みの
  暗黙のdefaultポリシーが持つボリューム名と同じ "default" にしている。
  ClickHouse は ALTER TABLE ... MODIFY SETTING storage_policy で別ポリシーに切り替える際、
  「旧ポリシーの各ボリュームが、同じ名前で新ポリシーにも存在し、そのディスク集合を含んでいること」
  を要求する (src/Disks/StoragePolicy.cpp の checkCompatibleWith を一次情報として確認済み)。
  ここを "hot" 等の別名にすると、clickhouse-init のALTERが
  "New storage policy hot_cold shall contain volumes of old one" で失敗する。
-->
<clickhouse>
    <storage_configuration>
        <disks>
            <cold>
                <type>s3</type>
                <!-- ClickHouseのS3ディスクはバケット名だけでは不可 (BAD_ARGUMENTS: "No key in S3 uri")。
                     バケット名の後に空でないキー(パスプレフィックス)が必須なため "clickhouse/" を付与している。 -->
                <endpoint>http://minio:9000/o11y-mcp-cold/clickhouse/</endpoint>
                <access_key_id from_env="MINIO_ROOT_USER"/>
                <secret_access_key from_env="MINIO_ROOT_PASSWORD"/>
            </cold>
        </disks>
        <policies>
            <hot_cold>
                <volumes>
                    <default>
                        <disk>default</disk>
                    </default>
                    <cold>
                        <disk>cold</disk>
                    </cold>
                </volumes>
            </hot_cold>
        </policies>
    </storage_configuration>
</clickhouse>
